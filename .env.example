# Copy to .env (git-ignored) and fill in locally. Never commit real values.
MYSQL_HOST=<rds-endpoint>
MYSQL_USER=<mysql-user>
MYSQL_PORT=3306
SILVER_SALT=<long random string, at least 16 characters; reuse it every run>
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
# Passwords are prompted at runtime. If you must set them, keep them in .env only:
# MYSQL_PASSWORD=
# NEO4J_PASSWORD=
